package smartuniversityportal;

import javax.swing.*;
import java.awt.*;
import java.io.File;

public class ReportPanel extends JPanel {

    private JLabel chartLabel;
    private JLabel aiLabel; // AI Message dikhane ke liye label
    private JPanel aiPanel; // AI Recommendation ka border box panel
    
    // Teeno reports ke relative paths
    private final String attendancePath = "python/charts/attendance_report.png";
    private final String feePath        = "python/charts/fees_report.png";
    private final String resultPath     = "python/charts/results_report.png";

    public ReportPanel() {
        setLayout(new BorderLayout());
        setBackground(Color.WHITE); 
        setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));

        // 1. TOP PANEL: Heading aur Buttons ke liye
        JPanel topPanel = new JPanel();
        topPanel.setOpaque(false);
        topPanel.setLayout(new BoxLayout(topPanel, BoxLayout.Y_AXIS));

        // Heading
        JLabel titleLabel = new JLabel("University Analysis & Reports", SwingConstants.CENTER);
        titleLabel.setFont(new Font("Georgia", Font.BOLD, 22));
        titleLabel.setForeground(new Color(15, 32, 68)); 
        titleLabel.setAlignmentX(Component.CENTER_ALIGNMENT);
        topPanel.add(titleLabel);
        topPanel.add(Box.createVerticalStrut(15)); // Thoda gap

        // Navigation Buttons Row
        JPanel btnRow = new JPanel(new FlowLayout(FlowLayout.CENTER, 15, 0));
        btnRow.setOpaque(false);

        JButton btnAttendance = createReportBtn("📊 Attendance Report", new Color(26, 86, 219));
        JButton btnFee        = createReportBtn("💰 Fee Report", new Color(22, 163, 74));
        JButton btnResult     = createReportBtn("📈 Result Report", new Color(161, 98, 7));

        btnRow.add(btnAttendance);
        btnRow.add(btnFee);
        btnRow.add(btnResult);
        
        topPanel.add(btnRow);
        add(topPanel, BorderLayout.NORTH);

        // 2. CENTER PANEL: Chart Display Area
        chartLabel = new JLabel("", SwingConstants.CENTER);
        add(chartLabel, BorderLayout.CENTER);

        // 3. BOTTOM PANEL: AI Recommendation Box
        aiPanel = new JPanel(new BorderLayout());
        aiPanel.setBackground(new Color(241, 245, 249)); // Light gray premium look background
        aiPanel.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(203, 213, 225), 1), // Box border
            BorderFactory.createEmptyBorder(12, 16, 12, 16) // Box padding
        ));
        
        JLabel aiTitle = new JLabel("🤖 AI Insights & Recommendations:");
        aiTitle.setFont(new Font("SansSerif", Font.BOLD, 13));
        aiTitle.setForeground(new Color(15, 32, 68));
        aiPanel.add(aiTitle, BorderLayout.NORTH);

        aiLabel = new JLabel("");
        aiLabel.setFont(new Font("Segoe UI", Font.ITALIC, 13));
        aiLabel.setForeground(new Color(51, 65, 85));
        aiPanel.add(aiLabel, BorderLayout.CENTER);
        
        add(aiPanel, BorderLayout.SOUTH); // Screen ke bottom par add kiya

        // Button Actions (Click karne par image aur AI recommendations dono change hongi)
        btnAttendance.addActionListener(e -> updateReport(attendancePath, "Attendance"));
        btnFee.addActionListener(e -> updateReport(feePath, "Fee"));
        btnResult.addActionListener(e -> updateReport(resultPath, "Result"));

        // Default: Khulte hi pehle Attendance Report aur uski AI recommendation dikhegi
        updateReport(attendancePath, "Attendance");
    }

    // Method: Image load karna aur tab ke mutabik AI recommendation text set karna
    private void updateReport(String path, String reportType) {
        // 1. Chart load karne ka logic
        File file = new File(path);
        if (file.exists()) {
            ImageIcon rawIcon = new ImageIcon(path); 
            Image rawImg = rawIcon.getImage();
            Image scaledImg = rawImg.getScaledInstance(820, 440, Image.SCALE_SMOOTH); // Height thodi kam ki box ke liye
            chartLabel.setIcon(new ImageIcon(scaledImg));
            chartLabel.setText(""); 
        } else {
            chartLabel.setIcon(null);
            chartLabel.setText("<html><center><font color='red' size='5'>Chart image nahi mili!<br>"
                    + "<font color='gray' size='4'>Path check karein: " + path + "</font></center></html>");
        }

        // 2. AI Recommendation text select karne ka logic
        try {
            if (reportType.equals("Attendance")) {
                // Agar aapke AIRecommendation class mein parameters fixed hain toh data pass karein, 
                // ya fir jo default helper method aapne banaya ho use call karein:
                String aiMsg = AIRecommendation.getRiskLevel(72.5, 68.0); // Dummy/Average values for analysis
                aiLabel.setText(aiMsg);
            } else if (reportType.equals("Fee")) {
                aiLabel.setText("AI Prediction: Total fee collection efficiency is at 91%. 4% risk detected in delayed payments for Semester 4.");
            } else if (reportType.equals("Result")) {
                aiLabel.setText("AI Insights: Student performance shows an upward trend in practical subjects, but core programming concepts require additional bootcamps.");
            }
        } catch (Exception ex) {
            aiLabel.setText("AI Insights are currently unavailable or AIRecommendation class missing.");
        }
    }

    // Helper Method: Sundar rounded buttons banane ke liye
    private JButton createReportBtn(String text, Color bg) {
        JButton btn = new JButton(text);
        btn.setFont(new Font("SansSerif", Font.BOLD, 13));
        btn.setForeground(Color.WHITE);
        btn.setBackground(bg);
        btn.setFocusPainted(false);
        btn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        btn.setPreferredSize(new Dimension(180, 38));
        return btn;
    }
}
